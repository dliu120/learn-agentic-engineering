---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<details class="my-8 rounded-md bg-surface px-4 py-3">
  <summary class="cursor-pointer font-medium text-text hover:text-accent">
    Deep dive: {title}
  </summary>
  <div class="prose-tight mt-4 space-y-4">
    <slot />
  </div>
</details>
