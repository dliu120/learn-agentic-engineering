---
interface Props {
  claim: string;
  correction: string;
}
const { claim, correction } = Astro.props;
---

<div class="my-6 grid gap-3 sm:grid-cols-2">
  <p class="rounded-md bg-signal-bad/5 p-4 text-sm leading-relaxed text-text-muted">
    <span class="mb-2 block font-mono text-[10px] uppercase tracking-[0.14em] text-signal-bad">Common Misconception</span>
    {claim}
  </p>
  <p class="rounded-md bg-signal-good/5 p-4 text-sm leading-relaxed text-text">
    <span class="mb-2 block font-mono text-[10px] uppercase tracking-[0.14em] text-signal-good">Correction</span>
    {correction}
  </p>
</div>
