---
import type { ModuleMeta } from '@/content/modules';
import { MODULE_BY_ID } from '@/content/modules';
import { moduleHref } from '@/lib/paths';

interface Props {
  module: ModuleMeta;
  lessonCount?: number;
}
const { module: m, lessonCount = 0 } = Astro.props;
const pathLabel =
  m.prerequisites.length === 0
    ? 'Start here'
    : `After ${m.prerequisites.map((id) => MODULE_BY_ID[id].num).join(' + ')}`;
---

<a
  href={moduleHref(m.id)}
  class="group grid min-w-0 gap-4 rounded-md px-3 py-5 no-underline transition-[background-color,color,transform] hover:bg-surface active:translate-y-px sm:grid-cols-[4rem_minmax(0,1fr)_10rem] sm:items-start"
  data-module={m.id}
>
  <div class="eyebrow pt-0.5">{m.num}</div>
  <div class="min-w-0">
    <h3 class="text-xl font-semibold tracking-[-0.02em] text-text transition-colors group-hover:text-accent">{m.name}</h3>
    <p class="mt-1 max-w-2xl text-sm leading-relaxed text-text-muted">{m.short}</p>
  </div>
  <div class="self-stretch sm:pt-1">
    <div class="flex items-center justify-between gap-3 text-xs text-text-faint">
      <span data-module-progress-label={m.id} data-default-label={`${lessonCount} lessons`}>{lessonCount} lessons</span>
      <span class="text-text-muted transition-colors group-hover:text-accent">{pathLabel}</span>
    </div>
    <div class="mt-3 h-1 overflow-hidden rounded-full bg-surface-2">
      <div
        class="h-full bg-accent transition-[width] duration-500"
        style="width:0%"
        data-module-progress-bar={m.id}
      >
      </div>
    </div>
  </div>
</a>
