---
interface Props {
  title?: string;
  items: string[];
}
const { title = 'Production failure modes', items } = Astro.props;
---

<section class="my-8 border-l-2 border-signal-warn pl-5">
  <h3 class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-signal-warn">{title}</h3>
  <ul class="mt-4 space-y-3">
    {
      items.map((it) => (
        <li class="text-sm leading-relaxed text-text-muted" set:html={it} />
      ))
    }
  </ul>
</section>
