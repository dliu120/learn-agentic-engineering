---
import { withBase } from '@/lib/paths';
const nav = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/modules'), label: 'Modules' },
  { href: withBase('/today'), label: 'Today' },
  { href: withBase('/glossary'), label: 'Glossary' },
  { href: withBase('/about'), label: 'About' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === withBase('/') ? path === href : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-7xl items-center gap-5 px-5 py-3 sm:px-6">
    <a href={withBase('/')} class="flex shrink-0 items-baseline gap-2 no-underline" translate="no">
      <span class="font-mono text-sm font-semibold tracking-[0.08em] text-text">ALLM</span>
      <span class="border-l border-border pl-2 text-sm text-text-muted">Academy</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-5 md:flex">
      {
        nav.map((n) => (
          <a
            href={n.href}
            aria-current={isActive(n.href) ? 'page' : undefined}
            class:list={[
              'border-b-2 py-1 text-sm no-underline transition-colors',
              isActive(n.href)
                ? 'border-accent text-text'
                : 'border-transparent text-text-muted hover:border-border hover:text-text',
            ]}
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-3">
      <button
        id="search-trigger"
        class="inline-flex h-9 items-center gap-2 border-l border-border pl-3 text-sm text-text-muted transition-colors hover:text-text"
        aria-label="Open search (Command or Control K)"
      >
        <span>Search</span><kbd class="kbd hidden sm:inline-flex">⌘&nbsp;K</kbd>
      </button>
      <button
        id="theme-toggle"
        class="h-9 border-l border-border pl-3 text-sm text-text-muted transition-colors hover:text-text"
        aria-label="Theme: Light. Activate to switch."
      >
        <span id="theme-label">Light</span>
      </button>
    </div>
  </div>

  <nav aria-label="Primary mobile" class="mx-auto flex max-w-7xl gap-5 overflow-x-auto px-5 pb-3 md:hidden">
    {
      nav.map((n) => (
        <a
          href={n.href}
          aria-current={isActive(n.href) ? 'page' : undefined}
          class:list={[
            'shrink-0 border-b-2 pb-1 text-sm no-underline',
            isActive(n.href) ? 'border-accent text-text' : 'border-transparent text-text-muted',
          ]}
        >
          {n.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const KEY = 'allm:theme';
  const order = ['light', 'dark', 'system'] as const;
  type Theme = (typeof order)[number];
  const label: Record<Theme, string> = { system: 'System', light: 'Light', dark: 'Dark' };

  function resolve(t: Theme) {
    return t === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : t;
  }
  function apply(t: Theme) {
    const resolved = resolve(t);
    document.documentElement.dataset.theme = resolved;
    document.querySelector('#theme-color')?.setAttribute('content', resolved === 'dark' ? '#111314' : '#f6f6f2');
    const el = document.getElementById('theme-label');
    const button = document.getElementById('theme-toggle');
    if (el) el.textContent = label[t];
    button?.setAttribute('aria-label', `Theme: ${label[t]}. Activate to switch.`);
    document.dispatchEvent(new CustomEvent('allm:theme-change'));
  }
  const current = (): Theme => ((localStorage.getItem(KEY) as Theme) ?? 'light');
  apply(current());

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = order[(order.indexOf(current()) + 1) % order.length];
    localStorage.setItem(KEY, next);
    apply(next);
  });

  document.getElementById('search-trigger')?.addEventListener('click', () => {
    (window as Window & { __allmOpenSearchPending?: boolean }).__allmOpenSearchPending = true;
    document.dispatchEvent(new CustomEvent('allm:open-search'));
  });
</script>
