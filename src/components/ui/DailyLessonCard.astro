---
import { MODULE_BY_ID } from '@/content/modules';
import { moduleHref, withBase } from '@/lib/paths';
import type { DailyLesson } from '@/content/schemas/daily';

interface Props {
  lesson: DailyLesson;
  index?: number;
}
const { lesson: l, index } = Astro.props;
const m = MODULE_BY_ID[l.module];
const linkUrl = (u: string) => (u.startsWith('http') ? u : withBase(u));
const primary = l.sourceLinks[0];
const signalLabels: Record<string, string> = { points: 'HN points', comments: 'comments', stars: 'GitHub stars', forks: 'forks' };
const signals = Object.entries(l.meta.signals ?? {});
---

<article class="grid gap-5 rounded-md px-3 py-7 transition-colors hover:bg-surface md:grid-cols-[3rem_minmax(0,1fr)_12rem]">
  <div class="font-mono text-sm tabular-nums text-text-faint">
    {index ? String(index).padStart(2, '0') : m.num}
  </div>

  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <a href={moduleHref(l.module)} class="eyebrow no-underline hover:text-text">{m.num} · {m.name}</a>
      <span class="text-xs text-text-faint">{l.meta.difficulty} · {l.meta.readingTimeMin} min</span>
    </div>

    <h2 class="mt-3 text-xl font-semibold leading-snug tracking-[-0.02em]">
      <a href={linkUrl(primary.url)} class="text-text no-underline hover:text-accent" rel="noopener" target={primary.url.startsWith('http') ? '_blank' : undefined}>
        {l.headline}
      </a>
    </h2>

    <ul class="mt-4 space-y-1.5">
      {l.summaryBullets.map((b) => (
        <li class="text-sm leading-relaxed text-text-muted">{b}</li>
      ))}
    </ul>

    <p class="mt-5 border-l-2 border-accent pl-4 text-sm leading-relaxed text-text-muted">
      <span class="font-semibold text-text">Why it matters. </span>{l.whyItMatters}
    </p>

    {l.microQuiz && (
      <details class="mt-5 rounded-md bg-surface-2 px-4 py-3">
        <summary class="cursor-pointer text-sm font-medium text-text">Quick check: {l.microQuiz.question}</summary>
        <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm text-text-muted">
          {l.microQuiz.options.map((o, i) => (
            <li class={i === l.microQuiz!.correct ? 'font-medium text-signal-good' : ''}>
              {i === l.microQuiz!.correct && <span>Correct: </span>}{o}
            </li>
          ))}
        </ol>
        <p class="mt-3 text-xs leading-relaxed text-text-faint">{l.microQuiz.explanation}</p>
      </details>
    )}
  </div>

  <aside class="text-xs text-text-faint md:border-l md:border-border md:pl-5">
    <p class="font-medium text-text-muted">Sources</p>
    <div class="mt-2 space-y-2">
      {l.sourceLinks.map((s) => (
        <div>
          <span class="font-mono text-[10px] uppercase tracking-wide text-accent">{s.type}</span>
          {s.publishedAt && <time datetime={s.publishedAt} class="ml-2 font-mono text-[10px] text-text-faint">{s.type === 'repository' ? 'active' : 'published'} {new Date(s.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })}</time>}
          <a href={linkUrl(s.url)} class="mt-0.5 block break-words no-underline hover:text-accent" rel="noopener" target={s.url.startsWith('http') ? '_blank' : undefined}>
            {s.title}
          </a>
          <span class="mt-0.5 block break-words text-[10px] text-text-faint">via {s.source}</span>
        </div>
      ))}
    </div>
    {signals.length > 0 && (
      <div class="mt-4 border-t border-border pt-3">
        <p class="font-medium text-text-muted">Discovery signals</p>
        <dl class="mt-1 space-y-1">
          {signals.map(([name, value]) => (
            <div class="flex justify-between gap-3">
              <dt>{signalLabels[name] ?? name}</dt>
              <dd class="font-mono tabular-nums text-text-muted">{value.toLocaleString('en-US')}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}
    <div class="mt-4 flex flex-wrap gap-x-2 gap-y-1 font-mono">
      {l.tags.slice(0, 4).map((t) => <span>#{t}</span>)}
    </div>
  </aside>
</article>
