---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { MODULE_BY_ID } from '@/content/modules';
import { moduleHref } from '@/lib/paths';

const entries = (await getCollection('glossary')).sort((a, b) => a.data.term.localeCompare(b.data.term));
const rendered = await Promise.all(
  entries.map(async (e) => ({ data: e.data, slug: e.id, Content: (await render(e)).Content })),
);
---

<BaseLayout title="Glossary — ALLM Academy" wide>
  <header class="grid gap-6 border-b border-border pb-10 md:grid-cols-[1fr_22rem] md:items-end">
    <div>
      <p class="eyebrow">Reference</p>
      <h1 class="mt-3 text-fluid-xl font-semibold tracking-[-0.04em] text-text">Glossary</h1>
      <p class="mt-3 text-fluid text-text-muted">The vocabulary of production-LLM engineering.</p>
    </div>
    <label class="block">
      <span class="text-sm font-medium text-text">Filter terms</span>
      <input
        id="glossary-filter"
        name="glossary-filter"
        type="search"
        placeholder="Type a term…"
        autocomplete="off"
        class="mt-2 w-full border-b border-border bg-transparent px-0 py-2 text-text outline-none placeholder:text-text-faint focus-visible:border-accent focus-visible:ring-0"
      />
    </label>
  </header>

  <dl class="mt-8 space-y-10">
    {
      rendered.map(({ data, slug, Content }) => {
        const m = data.module ? MODULE_BY_ID[data.module] : undefined;
        return (
          <div class="grid gap-3 md:grid-cols-[15rem_minmax(0,1fr)_4rem] md:gap-7" data-term id={slug} data-keywords={[data.term, ...data.aliases].join(' ').toLowerCase()}>
            <dt>
              <span class="text-lg font-semibold tracking-[-0.02em] text-text">{data.term}</span>
              {data.aliases.length > 0 && <span class="mt-1 block text-xs text-text-faint">{data.aliases.join(', ')}</span>}
            </dt>
            <dd class="prose-tight text-sm leading-relaxed">
              <Content />
            </dd>
            <div>
              {m && (
                <a href={moduleHref(m.id)} class="font-mono text-xs text-accent no-underline hover:text-text">
                  {m.num}
                </a>
              )}
            </div>
          </div>
        );
      })
    }
  </dl>
  <p id="glossary-empty" class="mt-4 hidden text-sm text-text-faint">No terms match.</p>
</BaseLayout>

<script>
  const input = document.getElementById('glossary-filter') as HTMLInputElement | null;
  const empty = document.getElementById('glossary-empty');
  input?.addEventListener('input', () => {
    const q = input.value.toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('[data-term]').forEach((el) => {
      const show = !q || (el.dataset.keywords ?? '').includes(q);
      el.style.display = show ? '' : 'none';
      if (show) shown++;
    });
    empty?.classList.toggle('hidden', shown > 0);
  });
</script>
