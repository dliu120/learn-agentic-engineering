---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Quiz from '@/components/islands/Quiz.tsx';
import AudioPlayer from '@/components/islands/AudioPlayer.tsx';
import { MODULE_BY_ID } from '@/content/modules';
import { withBase, lessonHref, moduleHref } from '@/lib/paths';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry) => ({
    params: { id: entry.data.moduleId, lesson: entry.data.lessonId },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const m = MODULE_BY_ID[d.moduleId];
const { Content } = await render(entry);

// sibling ordering: topic lessons by order, gate last
const sibs = (await getCollection('lessons', (e) => e.data.moduleId === d.moduleId)).sort((a, b) => {
  if (a.data.isModuleGate !== b.data.isModuleGate) return a.data.isModuleGate ? 1 : -1;
  return a.data.order - b.data.order;
});
const idx = sibs.findIndex((s) => s.data.lessonId === d.lessonId);
const prev = idx > 0 ? sibs[idx - 1] : null;
const next = idx < sibs.length - 1 ? sibs[idx + 1] : null;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const audioSrc = `${base}/audio/core/${d.moduleId}-${d.lessonId}.mp3`;
const vttSrc = `${base}/audio/core/${d.moduleId}-${d.lessonId}.vtt`;
const prerequisiteLinks = d.prerequisites.map((prerequisite) => {
  const module = MODULE_BY_ID[prerequisite.moduleId];
  return {
    label: prerequisite.label,
    href: prerequisite.lessonId
      ? lessonHref(prerequisite.moduleId, prerequisite.lessonId)
      : moduleHref(prerequisite.moduleId),
    module,
  };
});
---

<BaseLayout title={`${d.title} — ${m.name}`}>
  <div
    id="lesson-scroll-progress"
    class="fixed left-0 top-0 z-50 h-0.5 bg-accent"
    role="progressbar"
    aria-label="Lesson reading progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    style="width:0%"
  >
  </div>

  <nav class="text-sm text-text-faint" aria-label="Breadcrumb">
    <a href={withBase('/modules')} class="no-underline hover:text-text">Modules</a>
    <span class="mx-1 text-border">/</span>
    <a href={moduleHref(m.id)} class="no-underline hover:text-accent">{m.name}</a>
  </nav>

  <article class="mx-auto mt-6 max-w-prose" data-module-gate={d.isModuleGate ? 'true' : 'false'}>
    <button
      id="resume-position"
      type="button"
      class="mb-5 hidden border-b border-border pb-1 text-sm text-text no-underline hover:border-accent hover:text-accent"
    >
      Resume where you left off
    </button>

    <header class="pb-6">
      <p class="eyebrow">{d.isModuleGate ? 'Module Gate' : m.num}</p>
      <h1 class="mt-3 text-fluid-xl font-semibold leading-[1.08] tracking-[-0.04em] text-text">{d.title}</h1>
      <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs text-text-faint">
        <span>{d.estimatedMinutes} min</span>
        {d.deepDiveTopics.length > 0 && <span>{d.deepDiveTopics.length} optional deep dive{d.deepDiveTopics.length === 1 ? '' : 's'}</span>}
      </div>
      {d.summary && <p class="mt-5 text-fluid leading-relaxed text-text-muted">{d.summary}</p>}
      {
        prerequisiteLinks.length > 0 && (
          <nav class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm" aria-label="Lesson prerequisites">
            <span class="text-text-faint">Builds on</span>
            {prerequisiteLinks.map((prerequisite) => (
              <a href={prerequisite.href} class="border-b border-border pb-0.5 text-text no-underline hover:border-accent hover:text-accent">
                {prerequisite.label}
              </a>
            ))}
          </nav>
        )
      }
      {
        d.objectives.length > 0 && (
          <ol class="mt-6 space-y-3">
            {d.objectives.map((o, i) => (
              <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-3 text-sm leading-relaxed text-text-muted">
                <span class="font-mono text-xs tabular-nums text-accent">{String(i + 1).padStart(2, '0')}</span>
                <span>{o}</span>
              </li>
            ))}
          </ol>
        )
      }
    </header>

    {d.hasAudio && <AudioPlayer client:visible src={audioSrc} vtt={vttSrc} transcript={d.narration} title={`Narration — ${d.title}`} />}

    <div class="lesson-body mt-6">
      <Content />
    </div>

    {
      d.references.length > 0 && (
        <details class="mt-10 rounded-md bg-surface px-4 py-3">
          <summary class="cursor-pointer font-medium text-text hover:text-accent">
            References & deeper reading ({d.references.length})
          </summary>
          <ul class="mt-4 space-y-4">
            {d.references.map((reference) => (
              <li>
                <a href={reference.url} class="font-medium text-text no-underline hover:text-accent" target="_blank" rel="noopener">
                  {reference.title}
                </a>
                <span class="mt-1 block text-xs text-text-faint">{reference.source}</span>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    {
      d.quiz.length > 0 && (
        <Quiz client:visible questions={d.quiz} moduleId={d.moduleId} lessonId={d.lessonId} isGate={d.isModuleGate} />
      )
    }

    {
      !d.isModuleGate && d.quiz.length === 0 && (
        <button
          id="mark-complete"
          class="mt-8 rounded-sm border border-border px-4 py-2 text-sm text-text transition-colors hover:border-accent hover:text-accent active:translate-y-px"
          data-module={d.moduleId}
          data-lesson={d.lessonId}
        >
          Mark lesson complete
        </button>
      )
    }

    <nav
      class="mt-12 grid grid-cols-[1fr_auto_1fr] items-center gap-3 rounded-md bg-surface px-4 py-4 text-sm"
      aria-label="Lesson navigation"
    >
      {
        prev ? (
          <a href={lessonHref(prev.data.moduleId, prev.data.lessonId)} class="line-clamp-2 no-underline text-text-muted hover:text-text">
            Previous: {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      <span class="font-mono text-xs tabular-nums text-text-faint">{idx + 1}/{sibs.length}</span>
      {
        next ? (
          <a href={lessonHref(next.data.moduleId, next.data.lessonId)} class="line-clamp-2 text-right no-underline text-text-muted hover:text-text">
            Next: {next.data.title}
          </a>
        ) : (
          <a href={withBase('/modules')} class="text-right text-accent no-underline hover:text-text">
            Back to all modules
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<script>
  import { setLastVisited, markLessonComplete, isGatePassed, isLessonDone } from '@/lib/progress';
  // record visit (derive module/lesson from the URL)
  const parts = location.pathname.replace(/\/$/, '').split('/');
  const lessonId = parts.pop()!;
  const mod = parts.pop()!;
  if (mod && lessonId) setLastVisited(mod, lessonId);
  const isModuleGate = document.querySelector('[data-module-gate]')?.getAttribute('data-module-gate') === 'true';

  const positionKey = `allm:lesson-position:v1:${location.pathname}`;
  const previousPositionKey = location.pathname.includes('/modules/conversation-context-engineering/context-engineering')
    ? `allm:lesson-position:v1:${location.pathname.replace(
        '/modules/conversation-context-engineering/context-engineering',
        '/modules/foundations-prompts-to-harnesses/context-engineering',
      )}`
    : null;
  if (previousPositionKey && localStorage.getItem(positionKey) == null) {
    const previousPosition = localStorage.getItem(previousPositionKey);
    if (previousPosition != null) {
      localStorage.setItem(positionKey, previousPosition);
      localStorage.removeItem(previousPositionKey);
    }
  }
  const progress = document.getElementById('lesson-scroll-progress');
  const resume = document.getElementById('resume-position') as HTMLButtonElement | null;
  const savedPosition = Number(localStorage.getItem(positionKey) ?? 0);
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isComplete = () => isModuleGate ? isGatePassed(mod) : isLessonDone(mod, lessonId);
  let completed = isComplete();

  if (!completed && resume && savedPosition > 400 && savedPosition < document.documentElement.scrollHeight - innerHeight - 200) {
    resume.classList.remove('hidden');
    resume.addEventListener('click', () => {
      scrollTo({ top: savedPosition, behavior: reducedMotion ? 'auto' : 'smooth' });
      resume.classList.add('hidden');
    });
  }

  let lastSave = 0;
  let scheduled = false;
  let canSavePosition = false;
  const paintProgress = (savePosition: boolean) => {
    scheduled = false;
    const maximum = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    const percent = Math.min(100, Math.round((scrollY / maximum) * 100));
    if (progress) {
      progress.style.width = `${percent}%`;
      progress.setAttribute('aria-valuenow', String(percent));
    }
    const now = Date.now();
    if (savePosition && !completed && now - lastSave > 500) {
      localStorage.setItem(positionKey, String(Math.round(scrollY)));
      lastSave = now;
    }
  };
  addEventListener('scroll', () => {
    canSavePosition = true;
    if (!scheduled) {
      scheduled = true;
      requestAnimationFrame(() => paintProgress(true));
    }
  }, { passive: true });
  addEventListener('pagehide', () => {
    if (canSavePosition && !completed) localStorage.setItem(positionKey, String(Math.round(scrollY)));
  });
  const syncCompletion = () => {
    completed = isComplete();
    if (completed) {
      localStorage.removeItem(positionKey);
      resume?.classList.add('hidden');
    }
  };
  window.addEventListener('allm:progress', syncCompletion);
  syncCompletion();
  paintProgress(false);

  const btn = document.getElementById('mark-complete') as HTMLButtonElement | null;
  if (btn) {
    const sync = () => {
      const done = isLessonDone(btn.dataset.module!, btn.dataset.lesson!);
      btn.textContent = done ? 'Completed' : 'Mark lesson complete';
    };
    sync();
    btn.addEventListener('click', () => {
      markLessonComplete(btn.dataset.module!, btn.dataset.lesson!);
      sync();
    });
  }
</script>

<style>
  @reference '../../../styles/global.css';

  .lesson-body :global(h2) {
    @apply mt-12 text-2xl font-semibold tracking-[-0.025em] text-text;
  }
  .lesson-body :global(h3) {
    @apply mt-9 text-xl font-semibold tracking-[-0.02em] text-text;
  }
  .lesson-body :global(p) {
    @apply mt-5 text-fluid leading-[1.75] text-text-muted;
  }
  .lesson-body :global(ul),
  .lesson-body :global(ol) {
    @apply mt-4 list-disc space-y-1 pl-6 text-text-muted;
  }
  .lesson-body :global(code) {
    @apply rounded-sm bg-surface-2 px-1 py-0.5 text-sm text-accent;
  }
  .lesson-body :global(strong) {
    @apply text-text;
  }
  .lesson-body :global(a) {
    @apply text-accent;
  }
</style>
