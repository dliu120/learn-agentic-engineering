---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { MODULES, MODULE_BY_ID, TRACK_BY_ID, type ModuleMeta } from '@/content/modules';
import { lessonHref, moduleHref, withBase } from '@/lib/paths';
import { newsForModule, prettyDate } from '@/lib/daily';

export function getStaticPaths() {
  return MODULES.map((m) => ({ params: { id: m.id }, props: { module: m } }));
}

interface Props {
  module: ModuleMeta;
}
const { module: m } = Astro.props;

const all = await getCollection('lessons', (e) => e.data.moduleId === m.id);
const topicLessons = all.filter((l) => !l.data.isModuleGate).sort((a, b) => a.data.order - b.data.order);
const gate = all.find((l) => l.data.isModuleGate);
const related = (await newsForModule(m.id)).slice(0, 3);
const linkUrl = (u: string) => (u.startsWith('http') ? u : withBase(u));
const track = TRACK_BY_ID[m.track];
const prerequisites = m.prerequisites.map((id) => MODULE_BY_ID[id]);
---

<BaseLayout title={`${m.name} — ALLM Academy`} wide>
  <a href={withBase('/modules')} class="text-sm text-text-muted no-underline hover:text-accent">All modules</a>

  <header class="mt-6 grid gap-6 border-b border-border pb-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end">
    <div>
      <p class="eyebrow">{track.name} · {m.num}</p>
      <h1 class="mt-3 max-w-4xl text-fluid-xl font-semibold tracking-[-0.04em] text-text">{m.name}</h1>
      <p class="mt-4 max-w-2xl text-fluid leading-relaxed text-text-muted">{m.short}</p>
    </div>
    <p class="border-t border-border pt-4 text-sm leading-relaxed text-text-faint lg:border-t-0 lg:pt-0">
      {m.why}
      <span class="mt-3 block font-mono text-xs text-text-faint">{m.estimatedSessions}</span>
    </p>
  </header>

  {
    prerequisites.length > 0 && (
      <nav class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm" aria-label="Prerequisites">
        <span class="text-text-faint">Builds on</span>
        {prerequisites.map((prerequisite) => (
          <a href={moduleHref(prerequisite.id)} class="border-b border-border pb-0.5 text-text no-underline hover:border-accent hover:text-accent">
            {prerequisite.num} {prerequisite.name}
          </a>
        ))}
      </nav>
    )
  }

  <section class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div>
      <h2 class="eyebrow">What You’ll Be Able to Do</h2>
      <ol class="mt-4 divide-y divide-border border-y border-border">
        {
          m.objectives.map((o, i) => (
            <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-3 py-3 text-text-muted">
              <span class="font-mono text-xs tabular-nums text-accent">{String(i + 1).padStart(2, '0')}</span>
              <span>{o}</span>
            </li>
          ))
        }
      </ol>

      <h2 class="eyebrow mt-10">Lessons</h2>
      {
        topicLessons.length === 0 ? (
          <p class="mt-4 border-y border-dashed border-border py-4 text-sm text-text-faint">
            Lessons for this module are being authored.
          </p>
        ) : (
          <ol class="mt-4 border-b border-border">
            {topicLessons.map((l, i) => (
              <li class="border-t border-border">
                <a
                  href={lessonHref(m.id, l.data.lessonId)}
                  class="group grid grid-cols-[2.5rem_minmax(0,1fr)_auto] items-center gap-3 px-2 py-4 no-underline transition-colors hover:bg-surface"
                  data-lesson-key={`${m.id}/${l.data.lessonId}`}
                >
                  <span class="font-mono text-xs tabular-nums text-text-faint">{String(i + 1).padStart(2, '0')}</span>
                  <span class="min-w-0 text-text transition-colors group-hover:text-accent">{l.data.title}</span>
                  <span class="lesson-check text-xs text-signal-good" hidden>Completed</span>
                </a>
              </li>
            ))}
            {gate && (
              <li class="border-t border-border">
                <a
                  href={lessonHref(m.id, gate.data.lessonId)}
                  class="group grid grid-cols-[2.5rem_minmax(0,1fr)_auto] items-center gap-3 px-2 py-4 no-underline transition-colors hover:bg-surface"
                >
                  <span class="font-mono text-xs uppercase text-accent">Gate</span>
                  <span class="min-w-0 font-medium text-text transition-colors group-hover:text-accent">{gate.data.title}</span>
                  <span class="text-xs text-text-faint">Assessment</span>
                </a>
              </li>
            )}
          </ol>
        )
      }
    </div>

    <aside class="border-t border-border pt-6 lg:border-l lg:border-t-0 lg:pl-7 lg:pt-0">
      <div>
        <h3 class="eyebrow">Related News</h3>
        {
          related.length === 0 ? (
            <p class="mt-3 text-sm leading-relaxed text-text-faint">Daily items mapped to this module will appear here.</p>
          ) : (
            <ul class="mt-4 divide-y divide-border border-y border-border">
              {related.map(({ date, lesson }) => (
                <li class="py-4">
                  <a
                    href={linkUrl(lesson.sourceLinks[0].url)}
                    class="text-sm leading-snug text-text no-underline hover:text-accent"
                    rel="noopener"
                    target={lesson.sourceLinks[0].url.startsWith('http') ? '_blank' : undefined}
                  >
                    {lesson.headline}
                  </a>
                  <span class="mt-2 block text-xs text-text-faint">{prettyDate(date)} · {lesson.sourceLinks[0].source}</span>
                </li>
              ))}
            </ul>
          )
        }
        <a href={withBase(`/modules/${m.id}/news`)} class="mt-5 inline-block border-b border-border pb-1 text-sm text-text no-underline hover:border-accent hover:text-accent">
          View all module news
        </a>
      </div>
    </aside>
  </section>
</BaseLayout>

<script>
  // Mark completed lessons with a check from localStorage.
  import { getState } from '@/lib/progress';
  const paint = () => {
    const done = getState().lessons;
    document.querySelectorAll<HTMLElement>('[data-lesson-key]').forEach((a) => {
      const key = a.dataset.lessonKey!;
      const check = a.querySelector<HTMLElement>('.lesson-check');
      if (check) check.hidden = !done[key]?.completed;
    });
  };
  paint();
  window.addEventListener('allm:progress', paint);
</script>
