---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ModuleCard from '@/components/ui/ModuleCard.astro';
import { CURRICULUM_TRACKS, MODULES, MODULES_BY_TRACK, TOTAL_TOPIC_COUNT } from '@/content/modules';
import { buildManifest } from '@/lib/manifest';
import { moduleHref } from '@/lib/paths';

const lessons = await getCollection('lessons');
const countFor = (id: string) => lessons.filter((l) => l.data.moduleId === id && !l.data.isModuleGate).length;
const manifest = buildManifest(lessons);
const fundamentalsModules = MODULES_BY_TRACK.fundamentals;
const coreModules = MODULES_BY_TRACK['core-stages'];
const groupedTracks = CURRICULUM_TRACKS.filter((track) => track.id !== 'fundamentals');
---

<BaseLayout title="Modules — ALLM Academy" wide>
  <header class="grid gap-6 border-b border-border pb-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end">
    <div>
      <p class="eyebrow">Curriculum</p>
      <h1 class="mt-3 text-fluid-xl font-semibold tracking-[-0.04em] text-text">The Learning Path</h1>
      <p class="mt-4 max-w-2xl text-fluid leading-relaxed text-text-muted">
      Start with Fundamentals, then move through the 5 core stages. Open capability or production paths only when your
      current problem needs them. Prerequisites guide the order without turning the course into a maze.
      </p>
    </div>
    <dl class="grid grid-cols-2 gap-4 border-t border-border pt-4 lg:border-t-0 lg:pt-0">
      <div>
        <dt class="font-mono text-2xl tabular-nums text-text">{MODULES.length}</dt>
        <dd class="text-xs text-text-faint">Modules</dd>
      </div>
      <div>
        <dt class="font-mono text-2xl tabular-nums text-text">{TOTAL_TOPIC_COUNT}</dt>
        <dd class="text-xs text-text-faint">Topics</dd>
      </div>
    </dl>
  </header>

  <section id="fundamentals" class="scroll-mt-28 py-8" aria-labelledby="fundamentals-title">
    <div class="grid gap-3 sm:grid-cols-[12rem_minmax(0,1fr)_auto] sm:items-start">
      <h2 id="fundamentals-title" class="eyebrow">Start Here</h2>
      <p class="max-w-2xl text-sm leading-relaxed text-text-muted">
        Build the shared mental model for model calls, context windows, retrieval, state, memory, tools, and agents.
      </p>
      <span class="text-xs text-text-faint">{fundamentalsModules.reduce((total, module) => total + countFor(module.id), 0)} lessons</span>
    </div>
    <div class="mt-4 rounded-md bg-surface/70 px-1">
      {fundamentalsModules.map((module) => <ModuleCard module={module} lessonCount={countFor(module.id)} />)}
    </div>
  </section>

  <section class="py-8" aria-labelledby="core-map-title">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 id="core-map-title" class="eyebrow">Core Path at a Glance</h2>
      <span class="text-xs text-text-faint">Each stage contains the earlier ones</span>
    </div>
    <ol class="mt-5 grid gap-3 sm:grid-cols-5">
      {coreModules.map((module, index) => (
        <li class="rounded-md bg-surface p-4">
          <span class="font-mono text-xs tabular-nums text-accent">{String(index + 1).padStart(2, '0')}</span>
          <a href={moduleHref(module.id)} class="mt-2 block text-sm font-medium text-text no-underline hover:text-accent">
            {module.name}
          </a>
        </li>
      ))}
    </ol>
  </section>

  <div class="mt-8 space-y-5">
    {
      groupedTracks.map((track) => (
        <details id={track.id} class="scroll-mt-28 rounded-md bg-surface/70" open={track.defaultOpen}>
          <summary class="cursor-pointer list-none px-4 py-5 marker:hidden">
            <div class="grid gap-3 sm:grid-cols-[12rem_minmax(0,1fr)_auto] sm:items-start">
              <p class="eyebrow">{track.name}</p>
              <p class="max-w-2xl text-sm leading-relaxed text-text-muted">{track.short}</p>
              <span class="text-xs text-text-faint">{MODULES_BY_TRACK[track.id].length} modules</span>
            </div>
          </summary>
          <div class="space-y-1 px-1 pb-2">
            {MODULES_BY_TRACK[track.id].map((module) => (
              <ModuleCard module={module} lessonCount={countFor(module.id)} />
            ))}
          </div>
        </details>
      ))
    }
  </div>

  <script id="lesson-manifest" type="application/json" is:inline set:html={JSON.stringify(manifest)} />
</BaseLayout>

<script>
  import { hydrateModuleCards } from '@/lib/progress-ui';
  hydrateModuleCards();
  window.addEventListener('allm:progress', hydrateModuleCards);
</script>
