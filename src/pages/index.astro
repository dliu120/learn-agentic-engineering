---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ModuleCard from '@/components/ui/ModuleCard.astro';
import { CURRICULUM_TRACKS, MODULES_BY_TRACK, TOTAL_TOPIC_COUNT } from '@/content/modules';
import { withBase } from '@/lib/paths';
import { buildManifest } from '@/lib/manifest';
import { latestDay, prettyDate } from '@/lib/daily';
import CurationFlagBadge from '@/components/ui/CurationFlagBadge.astro';

const lessons = await getCollection('lessons');
const countFor = (id: string) => lessons.filter((l) => l.data.moduleId === id && !l.data.isModuleGate).length;
const manifest = buildManifest(lessons);
const today = await latestDay();
const fundamentalsModules = MODULES_BY_TRACK.fundamentals;
const fundamentalsLessonCount = fundamentalsModules.reduce((total, module) => total + countFor(module.id), 0);
const coreModules = MODULES_BY_TRACK['core-stages'];
const optionalTracks = CURRICULUM_TRACKS.filter((track) => !['fundamentals', 'core-stages'].includes(track.id));
---

<BaseLayout title="ALLM Academy — Production-LLM Engineering" wide>
  <section class="grid gap-12 border-b border-border pb-14 pt-4 lg:grid-cols-[minmax(0,1.55fr)_minmax(18rem,0.65fr)] lg:pb-20 lg:pt-10">
    <div>
      <p class="eyebrow">Production-LLM Engineering</p>
      <h1 class="mt-5 max-w-4xl text-fluid-2xl font-semibold leading-[1.02] tracking-[-0.045em] text-text">
        From one prompt to <span class="text-accent">engineered agent systems</span>.
      </h1>
      <p class="mt-6 max-w-2xl text-fluid leading-relaxed text-text-muted">
        {fundamentalsLessonCount} fundamentals and {TOTAL_TOPIC_COUNT} focused topics on the systems around the model:
        context, prompting, conversation, response contracts, loops, graphs, interoperability, state, serving,
        retrieval, evaluation, reliability, cost, and safety.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-5">
        <a
          href={withBase('/modules')}
          class="rounded-sm bg-accent px-5 py-3 font-medium text-bg no-underline transition-colors hover:bg-accent-hover active:translate-y-px"
          data-resume-target
        >
          Start with Fundamentals
        </a>
        <a
          href={withBase('/today')}
          class="border-b border-border pb-1 font-medium text-text no-underline transition-colors hover:border-accent hover:text-accent"
        >
          Read today’s briefing
        </a>
      </div>
    </div>

    <aside class="border-t border-border pt-5 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-1" aria-label="Course overview">
      <p class="eyebrow">Course Index</p>
      <dl class="mt-5 space-y-4">
        <div class="grid grid-cols-[4rem_1fr] gap-4 py-4">
          <dt class="font-mono text-2xl tabular-nums text-text">{fundamentalsLessonCount}</dt>
          <dd class="text-sm leading-relaxed text-text-muted">Fundamentals for model calls, context, retrieval, memory, tools, and agents</dd>
        </div>
        <div class="grid grid-cols-[4rem_1fr] gap-4 py-4">
          <dt class="font-mono text-2xl tabular-nums text-text">{coreModules.length}</dt>
          <dd class="text-sm leading-relaxed text-text-muted">Core stages from one request to graph-controlled systems</dd>
        </div>
        <div class="grid grid-cols-[4rem_1fr] gap-4 py-4">
          <dt class="font-mono text-2xl tabular-nums text-text">{TOTAL_TOPIC_COUNT}</dt>
          <dd class="text-sm leading-relaxed text-text-muted">Topics with diagrams, examples, quizzes, and deeper references</dd>
        </div>
        <div class="grid grid-cols-[4rem_1fr] gap-4 py-4">
          <dt class="font-mono text-sm text-accent">Daily</dt>
          <dd class="text-sm leading-relaxed text-text-muted">A source-linked briefing mapped back to the curriculum</dd>
        </div>
      </dl>
    </aside>
  </section>

  <section
    id="overall-summary"
    class="grid gap-6 border-b border-border py-8 md:grid-cols-[1.2fr_repeat(3,0.7fr)] md:items-end"
    aria-label="Your progress"
    data-overall-summary
  >
    <div>
      <p class="eyebrow">Your Progress</p>
      <p class="mt-2 text-sm text-text-muted">Stored only in this browser.</p>
    </div>
    {
      [
        { k: 'overall', label: 'Overall' },
        { k: 'lessons', label: 'Lessons done' },
        { k: 'quizzes', label: 'Quizzes passed' },
      ].map((s) => (
        <div class="border-l border-border pl-4">
          <div class="font-mono text-2xl tabular-nums text-text" data-summary={s.k}>—</div>
          <div class="mt-1 text-xs text-text-faint">{s.label}</div>
        </div>
      ))
    }
    <span class="hidden" data-summary="streak">—</span>
  </section>

  {
    today && (
      <section class="grid gap-6 border-b border-border py-10 lg:grid-cols-[16rem_minmax(0,1fr)]">
        <div>
          <p class="eyebrow">Today · {prettyDate(today.data.date)}</p>
          <div class="mt-3"><CurationFlagBadge flag={today.data.curationFlag} /></div>
          <a href={withBase('/today')} class="mt-6 inline-block border-b border-border pb-1 text-sm text-text no-underline hover:border-accent hover:text-accent">
            Open briefing
          </a>
        </div>
        <ol class="space-y-3">
          {today.data.lessons.slice(0, 4).map((l, i) => (
            <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3 text-sm">
              <span class="font-mono text-xs tabular-nums text-text-faint">{String(i + 1).padStart(2, '0')}</span>
              <span class="min-w-0 text-pretty text-text-muted">{l.headline}</span>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="pt-12">
    <div class="grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end">
      <div>
        <p class="eyebrow">Start Here</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.03em] text-text">Fundamentals</h2>
      </div>
      <span class="text-sm text-text-faint">{fundamentalsLessonCount} concise lessons · no assumed vocabulary</span>
    </div>
    <div class="mt-7 space-y-1">
      {fundamentalsModules.map((module) => <ModuleCard module={module} lessonCount={countFor(module.id)} />)}
    </div>
  </section>

  <section class="mt-12">
    <div class="grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end">
      <div>
        <p class="eyebrow">Curriculum</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.03em] text-text">The Core Stages</h2>
      </div>
      <span class="text-sm text-text-faint">{coreModules.length} stages · learn in order</span>
    </div>
    <div class="mt-7 space-y-1">
      {coreModules.map((m) => <ModuleCard module={m} lessonCount={countFor(m.id)} />)}
    </div>
  </section>

  <section class="mt-12 grid gap-5 lg:grid-cols-2">
    {
      optionalTracks.map((track) => (
        <a
          href={withBase(`/modules#${track.id}`)}
          class="group rounded-md bg-surface/70 px-4 py-6 no-underline transition-colors hover:bg-surface"
        >
          <p class="eyebrow">{track.name}</p>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-text-muted">{track.short}</p>
          <p class="mt-5 text-sm text-text transition-colors group-hover:text-accent">
            Explore {MODULES_BY_TRACK[track.id].length} modules
          </p>
        </a>
      ))
    }
  </section>
  <script id="lesson-manifest" type="application/json" is:inline set:html={JSON.stringify(manifest)} />
</BaseLayout>

<script>
  import { hydrateDashboard } from '@/lib/progress-ui';
  hydrateDashboard();
</script>
