---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CurationFlagBadge from '@/components/ui/CurationFlagBadge.astro';
import { allDays, prettyDate } from '@/lib/daily';
import { withBase } from '@/lib/paths';

const days = await allDays();
const allTags = [...new Set(days.flatMap((d) => d.data.lessons.flatMap((l) => l.tags)))].sort();
---

<BaseLayout title="Archive — ALLM Academy" wide>
  <div class="grid gap-6 border-b border-border pb-10 md:grid-cols-[1fr_18rem] md:items-end">
    <div>
      <p class="eyebrow">Daily Briefings</p>
      <h1 class="mt-3 text-fluid-xl font-semibold tracking-[-0.04em] text-text">Archive</h1>
      <p class="mt-3 text-fluid text-text-muted">{days.length} day{days.length === 1 ? '' : 's'} of source-linked AI-engineering news.</p>
    </div>
    <label class="block text-sm text-text">
      <span class="font-medium">Filter by tag</span>
      <select id="tag-filter" name="tag-filter" class="mt-2 w-full rounded-sm border border-border bg-surface px-2 py-2 text-text">
        <option value="">all</option>
        {allTags.map((t) => <option value={t}>{t}</option>)}
      </select>
    </label>
  </div>

  <div class="mt-6 space-y-1">
    {
      days.map((d) => {
        const tags = [...new Set(d.data.lessons.flatMap((l) => l.tags))];
        return (
          <a
            href={withBase(`/daily/${d.data.date}`)}
            class="grid gap-3 rounded-md px-3 py-4 no-underline transition-colors hover:bg-surface sm:grid-cols-[12rem_7rem_1fr] sm:items-center"
            data-day
            data-tags={tags.join(' ')}
          >
            <span class="font-mono text-sm text-text">{prettyDate(d.data.date)}</span>
            <CurationFlagBadge flag={d.data.curationFlag} />
            <span class="text-sm text-text-muted">{d.data.lessons.length} items</span>
            <span class="flex flex-wrap gap-x-2 gap-y-1">
              {tags.slice(0, 5).map((t) => (
                <span class="font-mono text-[10px] text-text-faint">#{t}</span>
              ))}
            </span>
          </a>
        );
      })
    }
  </div>
  <p id="archive-empty" class="mt-4 hidden text-sm text-text-faint">No briefings match that tag.</p>
</BaseLayout>

<script>
  const sel = document.getElementById('tag-filter') as HTMLSelectElement | null;
  const empty = document.getElementById('archive-empty');
  sel?.addEventListener('change', () => {
    const v = sel.value;
    let shown = 0;
    document.querySelectorAll<HTMLElement>('[data-day]').forEach((row) => {
      const tags = (row.dataset.tags ?? '').split(' ');
      const show = !v || tags.includes(v);
      row.style.display = show ? '' : 'none';
      if (show) shown++;
    });
    if (empty) empty.classList.toggle('hidden', shown > 0);
  });
</script>
